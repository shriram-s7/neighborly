# Copy to apps/api/.env and fill in real values. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/neighborly?schema=public"

# JWT secrets — required. Generate long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API port
PORT=4000

# Allowed browser origins for HTTP + Socket.IO (comma-separated). Defaults to localhost:5173 when unset.
# CORS_ORIGIN="https://your-app.vercel.app"
