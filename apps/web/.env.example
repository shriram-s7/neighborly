# Copy to apps/web/.env only if you need to override defaults. Never commit the real .env.
# Local dev needs nothing: Vite proxies /api and /socket.io to http://localhost:4000 (see vite.config.ts).

# Production: origin of the deployed API (no trailing slash, no /api/v1)
# VITE_API_URL="https://your-api.onrender.com"
# VITE_SOCKET_URL="https://your-api.onrender.com"
