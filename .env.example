# Root-level reference. The API reads apps/api/.env — see apps/api/.env.example.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/neighborly?schema=public"

# JWT Secrets (generate long random strings, e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Ports
PORT=4000
WEB_PORT=5173

# Optional LLM API Key (if provided, activates AI-assisted request parser)
# LLM_API_KEY=""
