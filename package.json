{
  "name": "neighborly-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @neighborly/api dev",
    "dev:web": "pnpm --filter @neighborly/web dev",
    "dev": "pnpm --parallel --filter @neighborly/api --filter @neighborly/web dev",
    "build": "pnpm --recursive build",
    "seed": "pnpm --filter @neighborly/api seed",
    "test": "pnpm --filter @neighborly/api test",
    "db:push": "pnpm --filter @neighborly/api db:push",
    "db:studio": "pnpm --filter @neighborly/api db:studio",
    "build:api": "pnpm --filter @neighborly/shared build && pnpm --filter @neighborly/api exec prisma generate && pnpm --filter @neighborly/api build",
    "build:web": "pnpm --filter @neighborly/shared build && pnpm --filter @neighborly/web build",
    "start:api": "node apps/api/dist/src/main.js",
    "db:migrate:deploy": "pnpm --filter @neighborly/api exec prisma migrate deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  }
}
